        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% ==========================================\n    %% 1. GEOGRAFÍA, SEDES Y ESTRUCTURA DEL TORNEO\n    %% ==========================================\n\n    class CONFEDERACION {\n        +int id_confederacion PK\n        +string nombre\n        +string sigla\n    }\n\n    class PAIS {\n        +int id_pais PK\n        +int id_confederacion FK\n        +string nombre\n        +string codigo_iso\n        +string huso_horario_estandar\n        +decimal pbi_per_capita\n        +string codigo_moneda\n    }\n\n    class CIUDAD {\n        +int id_ciudad PK\n        +int id_pais FK\n        +string nombre\n    }\n\n    class SEDE_ESTADIO {\n        +int id_sede PK\n        +int id_ciudad FK\n        +string nombre_estadio\n        +int capacidad\n        +string huso_horario\n        +decimal latitud\n        +decimal longitud\n    }\n\n    class GRUPO {\n        +int id_grupo PK\n        +string nombre_grupo\n    }\n\n    class FASE {\n        +int id_fase PK\n        +string nombre_fase\n        +int orden\n        +boolean permite_alargue\n        +boolean permite_penales\n    }\n\n    class SELECCION {\n        +int id_seleccion PK\n        +int id_pais FK\n        +int id_confederacion FK\n        +int id_grupo FK\n    }\n\n    class PARTIDO {\n        +int id_partido PK\n        +int id_fase FK\n        +int id_sede FK\n        +int id_seleccion_local FK\n        +int id_seleccion_visitante FK\n        +datetime fecha_hora_utc\n        +datetime fecha_hora_local\n        +int goles_local\n        +int goles_visitante\n        +int penales_local\n        +int penales_visitante\n        +int asistencia_publico\n        +string estado_partido\n    }\n\n    %% ==========================================\n    %% 2. PLANTELES, CONVOCATORIAS Y CUERPO TÉCNICO\n    %% ==========================================\n\n    class CLUB {\n        +int id_club PK\n        +int